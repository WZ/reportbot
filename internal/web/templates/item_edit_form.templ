package templates

import "fmt"

templ ItemEditForm(item ItemData, statuses []string) {
	<div id={ fmt.Sprintf("item-%d", item.ID) } class="edit-form">
		<form
			hx-post={ fmt.Sprintf("/items/%d", item.ID) }
			hx-target={ fmt.Sprintf("#item-%d", item.ID) }
			hx-swap="outerHTML"
		>
			<input type="text" name="description" value={ item.Description } placeholder="Description" required/>
			<div class="form-actions">
				<select name="status">
					for _, s := range statuses {
						<option value={ s } selected?={ s == item.Status }>{ s }</option>
					}
				</select>
				<input type="text" name="status_note" value={ item.StatusNote } placeholder="Status Note"/>
				<input type="text" name="ticket_ids" value={ item.TicketIDs } placeholder="Tickets"/>
				@SectionSelect(item.SectionGroups, item.SectionID, nil)
				<button type="submit" class="btn btn-primary">Save</button>
				<button type="button" class="btn btn-secondary"
					hx-get={ fmt.Sprintf("/items/%d/view", item.ID) }
					hx-target={ fmt.Sprintf("#item-%d", item.ID) }
					hx-swap="outerHTML"
				>Cancel</button>
			</div>
		</form>
	</div>
}
