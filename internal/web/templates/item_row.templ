package templates

import "fmt"

func srcClass(source string) string {
	switch source {
	case "gitlab":
		return "src src-gitlab"
	case "github":
		return "src src-github"
	case "import":
		return "src src-import"
	default:
		return "src src-slack"
	}
}

func srcLabel(source string) string {
	switch source {
	case "gitlab":
		return "GL"
	case "github":
		return "GH"
	case "import":
		return "IM"
	default:
		return "S"
	}
}

func statusClass(status string) string {
	switch status {
	case "done":
		return "status status-done"
	case "in progress":
		return "status status-progress"
	case "in testing":
		return "status status-review"
	case "blocked":
		return "status status-blocked"
	default:
		return "status"
	}
}

func placementText(item ItemData) string {
	if item.SectionID == 0 {
		if item.UndeterminedReason != "" {
			return "Undetermined: " + item.UndeterminedReason
		}
		return "Undetermined"
	}
	text := "placed by " + item.PlacedBy
	if item.Confidence != "" {
		text += " · " + item.Confidence
	}
	return text
}

templ ItemRow(item ItemData) {
	<div id={ fmt.Sprintf("item-%d", item.ID) } class={ "item", templ.KV("needs-attention", item.Attention != "") }>
		<span class={ srcClass(item.Source) } title={ item.Source }>{ srcLabel(item.Source) }</span>
		<div class="item-desc">
			<div class="text">{ item.Description }</div>
			<div class="meta">
				{ item.Author }
				if item.TicketIDs != "" {
					<span> &middot; { item.TicketIDs }</span>
				}
				<span> &middot; { placementText(item) }</span>
			</div>
		</div>
		if item.Attention != "" {
			<span class="attention">{ item.Attention }</span>
		}
		<span class={ statusClass(item.Status) }>{ item.StatusText }</span>
		if item.CanEdit {
			@SectionSelect(item.SectionGroups, item.SectionID, templ.Attributes{
				"class":     "reclassify",
				"hx-post":   fmt.Sprintf("/items/%d/move", item.ID),
				"hx-target": fmt.Sprintf("#item-%d", item.ID),
				"hx-swap":   "outerHTML",
			})
			<div class="item-actions">
				<button
					hx-get={ fmt.Sprintf("/items/%d/edit", item.ID) }
					hx-target={ fmt.Sprintf("#item-%d", item.ID) }
					hx-swap="outerHTML"
					title="Edit"
				>&#9998;</button>
				<button
					hx-post={ fmt.Sprintf("/items/%d/delete", item.ID) }
					hx-target={ fmt.Sprintf("#item-%d", item.ID) }
					hx-swap="delete"
					hx-confirm="Delete this Work Item?"
					title="Delete"
				>&times;</button>
			</div>
		}
	</div>
}

templ SectionSelect(groups []OptionGroup, selected int64, attrs templ.Attributes) {
	<select name="section_id" { attrs... }>
		<option value="0" selected?={ selected == 0 }>Undetermined</option>
		for _, g := range groups {
			<optgroup label={ g.Label }>
				for _, o := range g.Options {
					<option value={ fmt.Sprintf("%d", o.ID) } selected?={ o.ID == selected }>{ o.Name }</option>
				}
			</optgroup>
		}
	</select>
}
