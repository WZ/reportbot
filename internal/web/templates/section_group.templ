package templates

import "fmt"

templ SectionGroup(cat CategoryData) {
	<div class="section">
		<div class="section-header">
			<span class="name" title={ cat.Path }>{ cat.Name }</span>
			if len(cat.Items) > 0 {
				<span class="count">{ fmt.Sprintf("%d", len(cat.Items)) }</span>
			}
		</div>
		for _, item := range cat.Items {
			@ItemRow(item)
		}
		for _, sec := range cat.Sections {
			<div class="subsection-header">
				<span class="name" title={ sec.Path }>{ sec.Name }</span>
				<span class="count">{ fmt.Sprintf("%d", len(sec.Items)) }</span>
			</div>
			for _, item := range sec.Items {
				@ItemRow(item)
			}
		}
	</div>
}
