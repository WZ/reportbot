package templates

import "fmt"

type ReportPageData struct {
	WeekLabel string
	WeekParam string
	PrevWeek  string
	NextWeek  string
	IsManager bool
	CSRFToken string
	Body      ReportBodyData
}

type ReportBodyData struct {
	// NeedsCutover is true until migrate-v2 seeds the Taxonomy; nothing else is shown then.
	NeedsCutover bool
	WeekParam    string
	Version      string
	ItemCount    int
	Undetermined []ItemData
	Areas        []AreaData
}

type AreaData struct {
	Name       string
	Categories []CategoryData
}

// CategoryData holds the Category's own Work Items (when it is itself a Section) and its Sections.
type CategoryData struct {
	Name     string
	Path     string
	Items    []ItemData
	Sections []SectionData
}

type SectionData struct {
	Name  string
	Path  string
	Items []ItemData
}

type ItemData struct {
	ID                 int64
	Author             string
	Description        string
	Status             string
	StatusNote         string
	StatusText         string
	TicketIDs          string
	Source             string
	SectionID          int64
	PlacedBy           string
	Confidence         string // "" when no check was made
	UndeterminedReason string
	Attention          string // why the Work Item needs attention; "" when it does not
	CanEdit            bool
	SectionGroups      []OptionGroup
}

// OptionGroup is one "Area › Category" <optgroup> of the Section select.
type OptionGroup struct {
	Label   string
	Options []Option
}

type Option struct {
	ID   int64
	Name string
}

templ ReportPage(data ReportPageData) {
	@Layout("Live Weekly Report", data.CSRFToken, data.IsManager, "live") {
		<div class="editor-header">
			<h1>Weekly Report</h1>
			<div class="week-nav">
				<a href={ templ.SafeURL("/?week=" + data.PrevWeek) }>&larr;</a>
				<span>{ data.WeekLabel }</span>
				<a href={ templ.SafeURL("/?week=" + data.NextWeek) }>&rarr;</a>
			</div>
		</div>
		<div class="actions">
			if data.IsManager {
				<button class="btn btn-primary" hx-post={ "/generate?week=" + data.WeekParam } hx-target="#generate-status" hx-swap="innerHTML" hx-disabled-elt="this">
					Publish
				</button>
			}
			<button class="btn btn-secondary" hx-get={ "/preview?mode=team&week=" + data.WeekParam } hx-target="#preview-content" hx-swap="innerHTML">Preview team</button>
			<button class="btn btn-secondary" hx-get={ "/preview?mode=boss&week=" + data.WeekParam } hx-target="#preview-content" hx-swap="innerHTML">Preview boss</button>
		</div>
		<div id="generate-status"></div>
		<div class="editor-layout">
			<div class="editor-sections">
				@ReportBody(data.Body)
			</div>
			<div class="preview-panel">
				<h3>Markdown Preview</h3>
				<div id="preview-content" class="preview-body">
					<p class="muted">Pick a preview to see the rendered report.</p>
				</div>
			</div>
		</div>
	}
}

// ReportBody re-polls itself; the server answers 204 while the version is unchanged.
templ ReportBody(data ReportBodyData) {
	<div
		id="report-body"
		hx-get={ "/report/body?week=" + data.WeekParam + "&v=" + data.Version }
		hx-trigger="every 15s [!document.querySelector('#report-body .edit-form')], report-changed from:body"
		hx-swap="outerHTML"
	>
		if data.NeedsCutover {
			<div class="flash flash-error">Run the cut-over import (<code>reportbot migrate-v2</code>) to set up the report's Sections.</div>
		} else {
			<div class="stats">
				<span><span class="val">{ fmt.Sprintf("%d", data.ItemCount) }</span> Work Items</span>
				<span><span class="val">{ fmt.Sprintf("%d", len(data.Undetermined)) }</span> Undetermined</span>
			</div>
			if data.ItemCount == 0 {
				<div class="empty">
					<p>No Work Items this week.</p>
				</div>
			}
			if len(data.Undetermined) > 0 {
				<div class="section undetermined">
					<div class="section-header">
						<span class="name">Undetermined</span>
						<span class="count">{ fmt.Sprintf("%d", len(data.Undetermined)) }</span>
					</div>
					for _, item := range data.Undetermined {
						@ItemRow(item)
					}
				</div>
			}
			for _, area := range data.Areas {
				<h2 class="area-name">{ area.Name }</h2>
				for _, cat := range area.Categories {
					@SectionGroup(cat)
				}
			}
		}
	</div>
}
